      "direction": "Upper",
      "bound": 10.0,
      "penalty": { "tiers": [{ "rate": 80.0 }], "reject": 12.0 },
      "valid": true
    },
    {
      "name": "两档递增, 非末档带宽度",
      "rule": "合法基准",
      "direction": "Upper",
      "bound": 10.0,
      "penalty": {
        "tiers": [{ "rate": 80.0, "width": 0.5 }, { "rate": 150.0 }],
        "reject": 12.0
      },
      "valid": true
    },
    {
      "name": "零费率首档是合法的(某段不扣钱)",
